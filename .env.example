# MongoDB Atlas connection string — MUST include the database name and run on a
# replica set (Atlas always does; payroll approval uses multi-document transactions).
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cima?retryWrites=true&w=majority
DATABASE_URL=""

# Auth.js v5 — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Absolute base URL used in email links. On Vercel it is derived automatically
# from VERCEL_PROJECT_PRODUCTION_URL; set it only to override.
APP_URL=""

# Outgoing mail — SMTP, e.g. Gmail with an app password. With EMAIL_ENABLED
# different from "true" the app still writes in-app notifications, just no email.
EMAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sistema de administracion CIMA <correo@example.com>"

# Seed users (prisma/seed.ts)
SEED_OWNER_EMAIL="dueno@example.com"
SEED_OWNER_PASSWORD="cambiame-ya"
SEED_OWNER_NAME="Esteban Morales"
SEED_ASSISTANT_EMAIL="asistente@example.com"
SEED_ASSISTANT_PASSWORD="cambiame-ya"
SEED_ASSISTANT_NAME="Asistente Administrativa"
SEED_EMPLOYEE_PASSWORD="cambiame-ya"

# Set to "true" to also seed the fictional demo data from the design prototype
# (8 employees, 4 clients, 6 projects, current period) — dev only.
SEED_DEMO_DATA="true"
